@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = ViewBag.UserName ?? "User";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-root">

    <div class="dash-ambient" aria-hidden="true">
        <span class="ambient-blob blob-1"></span>
        <span class="ambient-blob blob-2"></span>
        <span class="ambient-blob blob-3"></span>
    </div>

    <!-- HERO -->
    <header class="dash-hero reveal-item">
        <div class="hero-left">
            <div class="hero-avatar">
                <span class="avatar-ring"></span>
                <img src="~/images/default-avatar.png"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                     alt="@userName profile photo"
                     class="avatar-img" />
                <div class="avatar-fallback" style="display:none">
                    <span>@userName.Substring(0, 1).ToUpper()</span>
                </div>
                <span class="avatar-status-dot" title="Active"></span>
            </div>
            <div class="hero-text">
                <p class="hero-greeting">Good morning ✦</p>
                <h1 class="hero-name">Welcome back, <em>@userName</em></h1>
                <p class="hero-sub">Your career journey is on track &#8212; keep pushing forward.</p>
            </div>
        </div>
        <div class="hero-right">
            <div class="hero-profile-strength">
                <div class="strength-header">
                    <span class="strength-label">Profile Strength</span>
                    <span class="strength-pct" id="heroStrengthPct">0%</span>
                </div>
                <div class="strength-track">
                    <div class="strength-fill" id="heroStrengthFill" data-value="72"></div>
                </div>
                <p class="strength-hint">Add 2 more skills to reach <strong>Expert</strong></p>
            </div>
            <div class="hero-quick-stats">
                <div class="qs-item">
                    <span class="qs-num" data-count="@(ViewBag.TotalApplications ?? 0)">0</span>
                    <span class="qs-lbl">Applied</span>
                </div>
                <div class="qs-divider"></div>
                <div class="qs-item">
                    <span class="qs-num" data-count="3">0</span>
                    <span class="qs-lbl">Interviews</span>
                </div>
                <div class="qs-divider"></div>
                <div class="qs-item">
                    <span class="qs-num" data-count="9">0</span>
                    <span class="qs-lbl">Saved</span>
                </div>
            </div>
        </div>
    </header>

    <!-- AI INSIGHT BANNER -->
    <div class="ai-insight-banner reveal-item" id="aiInsightBanner">
        <div class="ai-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a4 4 0 0 1 4 4c0 1.5-.8 2.8-2 3.5V12h-4V9.5A4 4 0 0 1 8 6a4 4 0 0 1 4-4z" />
                <path d="M8 12H5a2 2 0 0 0-2 2v6h18v-6a2 2 0 0 0-2-2h-3" />
                <circle cx="12" cy="18" r="1" />
            </svg>
        </div>
        <div class="ai-text">
            <strong>AI Career Insight</strong>
            <span id="aiInsightText">Your profile strength improved by 12% this week. React & .NET roles are trending in Lahore — 3 new matches found.</span>
        </div>
        <button class="ai-dismiss" id="aiDismiss" aria-label="Dismiss insight">&times;</button>
    </div>

    <!-- KPI CARDS -->
    <section class="kpi-grid" aria-label="Key performance indicators">

        <div class="kpi-card reveal-item" data-delay="0">
            <div class="kpi-icon kpi-teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <polyline points="10 9 9 9 8 9" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Jobs Applied</span>
                <span class="kpi-value counter" data-count="@(ViewBag.TotalApplications ?? 0)">0</span>
                <span class="kpi-trend trend-up">Total applications</span>
            </div>
        </div>

        <div class="kpi-card reveal-item" data-delay="80">
            <div class="kpi-icon kpi-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Saved Jobs</span>
                <span class="kpi-value counter" data-count="0">0</span>
                <span class="kpi-trend trend-neutral">Feature coming soon</span>
            </div>
        </div>

    <div class="kpi-card reveal-item" data-delay="160">
        <div class="kpi-icon kpi-teal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
        </div>
        <div class="kpi-body">
            <span class="kpi-label">Interviews Scheduled</span>
            <span class="kpi-value counter" data-count="0">0</span>
            <span class="kpi-trend trend-neutral">Feature coming soon</span>
        </div>
    </div>

        <div class="kpi-card reveal-item" data-delay="240">
            <div class="kpi-icon kpi-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Pending</span>
                <span class="kpi-value counter" data-count="@(ViewBag.PendingApplications ?? 0)">0</span>
                <span class="kpi-trend trend-up">Awaiting response</span>
            </div>
        </div>

        <div class="kpi-card reveal-item" data-delay="320">
            <div class="kpi-icon kpi-teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Profile Views</span>
            <span class="kpi-value counter" data-count="0">0</span>
                <span class="kpi-trend trend-up">↑ 18 this month</span>
            </div>
        </div>

        <div class="kpi-card reveal-item" data-delay="400">
            <div class="kpi-icon kpi-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Accepted</span>
                <span class="kpi-value counter" data-count="@(ViewBag.AcceptedApplications ?? 0)">0</span>
                <span class="kpi-trend trend-up">Accepted applications</span>
            </div>
        </div>

    </section>

    <!-- MAIN CONTENT GRID -->
    <div class="dash-content-grid">

        <!-- LEFT COLUMN -->
        <div class="dash-col-main">

            <!-- CHARTS SECTION -->
            <section class="dash-section reveal-item" aria-label="Analytics charts">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="title-dot teal-dot"></span>
                        My Job Search Analytics
                    </h2>
                    <div class="chart-period-toggle" role="group" aria-label="Chart period">
                        <button class="period-btn active" data-period="weekly">Weekly</button>
                        <button class="period-btn" data-period="monthly">Monthly</button>
                    </div>
                </div>

                <div class="charts-grid">
                    <div class="chart-card chart-wide reveal-item">
                        <div class="chart-card-header">
                            <span class="chart-title">Applications Over Time</span>
                            <span class="chart-badge teal-badge">Line</span>
                        </div>
                        <div class="chart-canvas-wrap">
                            <canvas id="chartApplicationsOverTime"></canvas>
                        </div>
                    </div>

                    <div class="chart-card reveal-item">
                        <div class="chart-card-header">
                            <span class="chart-title">Status Breakdown</span>
                            <span class="chart-badge amber-badge">Doughnut</span>
                        </div>
                        <div class="chart-canvas-wrap chart-doughnut-wrap">
                            <canvas id="chartStatusBreakdown"></canvas>
                        </div>
                    </div>

                    <div class="chart-card reveal-item">
                        <div class="chart-card-header">
                            <span class="chart-title">Application Funnel</span>
                            <span class="chart-badge teal-badge">Bar</span>
                        </div>
                        <div class="chart-canvas-wrap">
                            <canvas id="chartFunnel"></canvas>
                        </div>
                    </div>

                    <div class="chart-card reveal-item">
                        <div class="chart-card-header">
                            <span class="chart-title">Skill Demand Match</span>
                            <span class="chart-badge amber-badge">Radar</span>
                        </div>
                        <div class="chart-canvas-wrap">
                            <canvas id="chartSkillRadar"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TABBED MODULE SECTION -->
            <section class="dash-section reveal-item" aria-label="Job modules">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="title-dot amber-dot"></span>
                        My Activity
                    </h2>
                </div>

                <!-- SEARCH + FILTER BAR -->
                <div class="filter-bar" id="filterBar" role="search">
                    <div class="filter-search-wrap">
                        <svg class="filter-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        <input type="text" id="searchInput" class="filter-search-input"
                               placeholder="Search applications, companies..." aria-label="Search applications" />
                    </div>
                    <div class="filter-dropdowns">
                        <div class="filter-dropdown-wrap">
                            <select id="filterStatus" class="filter-select" aria-label="Filter by status">
                                <option value="">All Statuses</option>
                                <option value="pending">Pending</option>
                                <option value="accepted">Accepted</option>
                                <option value="rejected">Rejected</option>
                            </select>
                            <svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </div>
                        <div class="filter-dropdown-wrap">
                            <select id="filterDate" class="filter-select" aria-label="Filter by date">
                                <option value="">Any Date</option>
                                <option value="7">Last 7 days</option>
                                <option value="30">Last 30 days</option>
                                <option value="90">Last 3 months</option>
                            </select>
                            <svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- TABS -->
                <div class="tabs-nav" role="tablist" aria-label="Activity tabs">
                    <button class="tab-btn active" role="tab" aria-selected="true"
                            aria-controls="tab-applications" data-tab="applications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                        </svg>
                        Applications
                        <span class="tab-badge">@(ViewBag.TotalApplications ?? 0)</span>
                    </button>
                    <button class="tab-btn" role="tab" aria-selected="false"
                            aria-controls="tab-saved" data-tab="saved">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                        </svg>
                        Saved Jobs
                        <span class="tab-badge amber">0</span>
                    </button>
                    <button class="tab-btn" role="tab" aria-selected="false"
                            aria-controls="tab-recommended" data-tab="recommended">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                        Recommended
                        <span class="tab-badge">0</span>
                    </button>
                    <button class="tab-btn" role="tab" aria-selected="false"
                            aria-controls="tab-interviews" data-tab="interviews">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        Interviews
                        <span class="tab-badge teal">0</span>
                    </button>
                </div>

                <!-- TAB: APPLICATIONS (DYNAMIC FROM DB) -->
                <div id="tab-applications" class="tab-panel active" role="tabpanel">
                    <div class="applications-list" id="applicationsList">

                        @if (ViewBag.MyApplications != null && ((List<CareerInn.Models.JobApplication>)ViewBag.MyApplications).Count > 0)
                        {
                            foreach (var app in (List<CareerInn.Models.JobApplication>)ViewBag.MyApplications)
                            {
                                <div class="app-row"
                                     data-company="@app.Job.Company.Name.ToLower()"
                                     data-status="@app.Status.ToLower()"
                                     data-date="7">
                                    <div class="app-logo-wrap">
                                        <div class="app-logo" style="background:#0d948820">
                                            <span>@app.Job.Company.Name.Substring(0, 2).ToUpper()</span>
                                        </div>
                                    </div>
                                    <div class="app-info">
                                        <p class="app-title">@app.Job.Title</p>
                                        <p class="app-company">@app.Job.Company.Name &middot; @app.Job.Location</p>
                                        <p class="app-date">Applied @app.AppliedAt.ToString("MMM dd, yyyy")</p>
                                    </div>
                                    <div class="app-right">
                                        <span class="status-badge badge-@app.Status.ToLower()">@app.Status</span>
                                        <div class="app-timeline-mini">
                                            <span class="tl-dot done" title="Applied"></span>
                                            <span class="tl-line"></span>
                                            <span class="tl-dot" title="Reviewed"></span>
                                            <span class="tl-line"></span>
                                            <span class="tl-dot" title="Decision"></span>
                                        </div>
                                        <a asp-controller="Jobs" asp-action="Details"
                                               asp-route-id="@app.JobId" class="btn-view">
                                            View Job
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <p style="color:#888">You have not applied to any jobs yet.</p>
                                <a asp-controller="Jobs" asp-action="Index" class="btn-view mt-3">
                                    Browse Jobs
                                </a>
                            </div>
                        }

                    </div>
                    <p class="no-results-msg" id="noResultsMsg" style="display:none">No applications match your filters.</p>
                </div>

                <!-- TAB: SAVED JOBS -->
                <div id="tab-saved" class="tab-panel" role="tabpanel">
                    <div class="saved-grid" id="savedJobsGrid">

                        <div class="saved-card" data-saved-id="s1">
                            <button class="bookmark-btn bookmarked" data-saved-id="s1" aria-label="Remove bookmark">
                                <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                </svg>
                            </button>
                            <div class="saved-logo" style="background:#0d948815"><span>GG</span></div>
                            <p class="saved-title">Senior React Developer</p>
                            <p class="saved-company">GlobalGrid &#183; Remote</p>
                            <div class="saved-tags">
                                <span class="tag">React</span><span class="tag">TypeScript</span><span class="tag">Remote</span>
                            </div>
                            <div class="saved-footer">
                                <span class="saved-salary">$85k–$110k</span>
                                <button class="btn-quick-apply">Quick Apply</button>
                            </div>
                        </div>

                        <div class="saved-card" data-saved-id="s2">
                            <button class="bookmark-btn bookmarked" data-saved-id="s2" aria-label="Remove bookmark">
                                <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                </svg>
                            </button>
                            <div class="saved-logo" style="background:#d9770615"><span>AV</span></div>
                            <p class="saved-title">Product Designer (UI/UX)</p>
                            <p class="saved-company">Avanta &#183; Lahore</p>
                            <div class="saved-tags">
                                <span class="tag">Figma</span><span class="tag">UI/UX</span><span class="tag">SaaS</span>
                            </div>
                            <div class="saved-footer">
                                <span class="saved-salary">PKR 180k–250k</span>
                                <button class="btn-quick-apply">Quick Apply</button>
                            </div>
                        </div>

                        <div class="saved-card" data-saved-id="s3">
                            <button class="bookmark-btn bookmarked" data-saved-id="s3" aria-label="Remove bookmark">
                                <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                </svg>
                            </button>
                            <div class="saved-logo" style="background:#0d948815"><span>NS</span></div>
                            <p class="saved-title">.NET Core Backend Engineer</p>
                            <p class="saved-company">NovaSoft &#183; Hybrid</p>
                            <div class="saved-tags">
                                <span class="tag">.NET</span><span class="tag">C#</span><span class="tag">EF Core</span>
                            </div>
                            <div class="saved-footer">
                                <span class="saved-salary">PKR 250k–350k</span>
                                <button class="btn-quick-apply">Quick Apply</button>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- TAB: RECOMMENDED -->
                <div id="tab-recommended" class="tab-panel" role="tabpanel">
                    <div class="rec-intro">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 8v4l3 3" />
                        </svg>
                        <span>AI-powered recommendations based on your skills &amp; activity</span>
                    </div>
                    <div class="rec-grid" id="recommendedGrid">

                        <div class="rec-card">
                            <div class="rec-match-badge">98% Match</div>
                            <div class="rec-logo" style="background:#0d948815"><span>PX</span></div>
                            <p class="rec-title">Frontend Engineer (React + TS)</p>
                            <p class="rec-company">Pixelate Labs &#183; Remote</p>
                            <p class="rec-reason">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                                Because you know React, TypeScript &amp; UI Design
                            </p>
                            <div class="rec-tags">
                                <span class="tag">React</span><span class="tag">TypeScript</span><span class="tag">Tailwind</span>
                            </div>
                            <div class="rec-footer">
                                <span class="rec-salary">$75k–$95k</span>
                                <button class="btn-quick-apply">Apply Now</button>
                            </div>
                        </div>

                        <div class="rec-card">
                            <div class="rec-match-badge amber-badge-sm">91% Match</div>
                            <div class="rec-logo" style="background:#d9770615"><span>CN</span></div>
                            <p class="rec-title">ASP.NET MVC Developer</p>
                            <p class="rec-company">CloudNest &#183; Karachi</p>
                            <p class="rec-reason">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                                Because you know C#, .NET &amp; MVC
                            </p>
                            <div class="rec-tags">
                                <span class="tag">C#</span><span class="tag">.NET</span><span class="tag">SQL</span>
                            </div>
                            <div class="rec-footer">
                                <span class="rec-salary">PKR 300k+</span>
                                <button class="btn-quick-apply">Apply Now</button>
                            </div>
                        </div>

                        <div class="rec-card">
                            <div class="rec-match-badge">87% Match</div>
                            <div class="rec-logo" style="background:#0d948815"><span>SH</span></div>
                            <p class="rec-title">Full Stack Engineer</p>
                            <p class="rec-company">SkyHive &#183; Remote / Lahore</p>
                            <p class="rec-reason">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                                Because you know React, C# &amp; REST APIs
                            </p>
                            <div class="rec-tags">
                                <span class="tag">React</span><span class="tag">C#</span><span class="tag">REST</span>
                            </div>
                            <div class="rec-footer">
                                <span class="rec-salary">$65k–$85k</span>
                                <button class="btn-quick-apply">Apply Now</button>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- TAB: INTERVIEWS -->
                <div id="tab-interviews" class="tab-panel" role="tabpanel">
                    <div class="interview-list">

                        <div class="interview-item">
                            <div class="iv-header">
                                <div class="iv-logo" style="background:#0d948815"><span>TC</span></div>
                                <div class="iv-info">
                                    <p class="iv-title">Senior Frontend Engineer</p>
                                    <p class="iv-company">TechCorp &#183; <span class="iv-date">May 16, 2025 &#64; 2:00 PM</span></p>
                                </div>
                                <span class="status-badge badge-interview">Technical Round</span>
                            </div>
                            <div class="iv-timeline">
                                <div class="ivt-step done">
                                    <div class="ivt-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg></div>
                                    <div class="ivt-label">Applied</div>
                                </div>
                                <div class="ivt-line done"></div>
                                <div class="ivt-step done">
                                    <div class="ivt-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg></div>
                                    <div class="ivt-label">HR Screening</div>
                                </div>
                                <div class="ivt-line done"></div>
                                <div class="ivt-step active">
                                    <div class="ivt-circle pulse-ring"><span>3</span></div>
                                    <div class="ivt-label">Technical</div>
                                </div>
                                <div class="ivt-line"></div>
                                <div class="ivt-step">
                                    <div class="ivt-circle"><span>4</span></div>
                                    <div class="ivt-label">Final Round</div>
                                </div>
                            </div>
                        </div>

                        <div class="interview-item">
                            <div class="iv-header">
                                <div class="iv-logo" style="background:#d9770615"><span>NL</span></div>
                                <div class="iv-info">
                                    <p class="iv-title">Full Stack Developer (.NET + React)</p>
                                    <p class="iv-company">NexaLab &#183; <span class="iv-date">May 18, 2025 &#64; 11:00 AM</span></p>
                                </div>
                                <span class="status-badge badge-shortlisted">HR Screening</span>
                            </div>
                            <div class="iv-timeline">
                                <div class="ivt-step done">
                                    <div class="ivt-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg></div>
                                    <div class="ivt-label">Applied</div>
                                </div>
                                <div class="ivt-line done"></div>
                                <div class="ivt-step active">
                                    <div class="ivt-circle pulse-ring"><span>2</span></div>
                                    <div class="ivt-label">HR Screening</div>
                                </div>
                                <div class="ivt-line"></div>
                                <div class="ivt-step">
                                    <div class="ivt-circle"><span>3</span></div>
                                    <div class="ivt-label">Technical</div>
                                </div>
                                <div class="ivt-line"></div>
                                <div class="ivt-step">
                                    <div class="ivt-circle"><span>4</span></div>
                                    <div class="ivt-label">Final Round</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </section>

        </div><!-- /.dash-col-main -->
        <!-- RIGHT SIDEBAR -->
        <aside class="dash-col-side">

            <!-- Profile Strength Widget -->
            <div class="side-widget reveal-item" aria-label="Profile strength widget">
                <div class="widget-header">
                    <h3 class="widget-title">Profile Strength</h3>
                    <span class="widget-pct" id="sideStrengthPct">72%</span>
                </div>
                <div class="widget-strength-track">
                    <div class="widget-strength-fill" data-value="72"></div>
                </div>
                <p class="widget-level">Level: <strong>Advanced</strong></p>
                <ul class="strength-suggestions" aria-label="Suggestions to improve profile">
                    <li class="suggestion done">
                        <span class="sug-check">✓</span>
                        Add profile photo
                    </li>
                    <li class="suggestion done">
                        <span class="sug-check">✓</span>
                        Write a headline
                    </li>
                    <li class="suggestion">
                        <span class="sug-bullet"></span>
                        Add 3 more skills
                    </li>
                    <li class="suggestion">
                        <span class="sug-bullet"></span>
                        Complete your resume
                    </li>
                    <li class="suggestion">
                        <span class="sug-bullet"></span>
                        Add work experience
                    </li>
                </ul>
                <button class="btn-complete-profile">Complete Profile</button>
            </div>

            <!-- Resume Upload Widget -->
            <div class="side-widget reveal-item" aria-label="Resume status">
                <div class="widget-header">
                    <h3 class="widget-title">Resume Status</h3>
                </div>
                @if (ViewBag.LatestResume != null)
                {
                    <div class="resume-status-card uploaded">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                        </svg>
                        <div class="resume-info">
                            <p class="resume-name">My_Resume.pdf</p>
                            <p class="resume-meta">Uploaded @ViewBag.LatestResumeDate &middot; <span class="resume-status-tag">Current</span></p>
                        </div>
                    </div>
                    <div class="resume-actions">
                        <a href="@ViewBag.LatestResume" target="_blank" class="btn-resume-view">Preview</a>
                    </div>
                }
                else
                {
                    <div class="resume-status-card">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                        </svg>
                        <div class="resume-info">
                            <p class="resume-name">No resume uploaded yet</p>
                            <p class="resume-meta">Upload when applying for jobs</p>
                        </div>
                    </div>
                }
            </div>
            <!-- Weekly Summary Widget -->
            <div class="side-widget reveal-item" aria-label="Weekly job search summary">
                <div class="widget-header">
                    <h3 class="widget-title">This Week</h3>
                </div>
                <div class="weekly-stats">
                    <div class="ws-row">
                        <span class="ws-icon">📄</span>
                        <span class="ws-label">Applications sent</span>
                        <span class="ws-val">@(ViewBag.WeeklyApplications ?? 0)</span>
                    </div>
                    <div class="ws-row">
                        <span class="ws-icon">⏳</span>
                        <span class="ws-label">Pending</span>
                        <span class="ws-val">@(ViewBag.PendingApplications ?? 0)</span>
                    </div>
                    <div class="ws-row">
                        <span class="ws-icon">✅</span>
                        <span class="ws-label">Accepted</span>
                        <span class="ws-val">@(ViewBag.AcceptedApplications ?? 0)</span>
                    </div>
                    <div class="ws-row">
                        <span class="ws-icon">📊</span>
                        <span class="ws-label">Total applied</span>
                        <span class="ws-val">@(ViewBag.TotalApplications ?? 0)</span>
                    </div>
                </div>
            </div>

            <!-- Notification Widget -->
            <div class="side-widget reveal-item notification-widget" aria-label="Notifications">
                <div class="widget-header">
                    <h3 class="widget-title">Notifications</h3>
                    <span class="notif-pulse-dot" aria-label="3 new notifications"></span>
                </div>
                <ul class="notif-list">
                    <li class="notif-item notif-unread">
                        <span class="notif-icon teal-icon">📬</span>
                        <div class="notif-text">
                            <p>You have <strong>@(ViewBag.PendingApplications ?? 0)</strong> pending applications</p>
                            <span class="notif-time">Updated now</span>
                        </div>
                    </li>
                    <li class="notif-item notif-unread">
                        <span class="notif-icon amber-icon">⭐</span>
                        <div class="notif-text">
                            <p>3 new jobs match your profile</p>
                            <span class="notif-time">5 hours ago</span>
                        </div>
                    </li>
                    <li class="notif-item">
                        <span class="notif-icon">📋</span>
                        <div class="notif-text">
                            <p>Your resume was downloaded</p>
                            <span class="notif-time">3 days ago</span>
                        </div>
                    </li>
                </ul>
            </div>

        </aside>
    </div>

</div><!-- /.dash-root -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

