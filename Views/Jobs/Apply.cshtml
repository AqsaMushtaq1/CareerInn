@model CareerInn.Models.Job

@{
    ViewData["Title"] = "Apply - " + Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/jobs.css" asp-append-version="true" />
}

<section class="job-detail-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="job-detail-card">

                    <div class="job-detail-header">
                        <div class="job-detail-avatar">
                            @Model.Company.Name.Substring(0, 2).ToUpper()
                        </div>
                        <div class="job-detail-header-info">
                            <h1 class="job-detail-title">@Model.Title</h1>
                            <p class="job-detail-company">
                                <i class="fas fa-building me-2"></i>@Model.Company.Name
                            </p>
                        </div>
                    </div>

                   

                    <form asp-action="Apply" asp-controller="Jobs"
                          asp-route-id="@Model.Id"
                          method="post"
                          enctype="multipart/form-data">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(true)
                            </div>
                        }

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                        }

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Cover Letter
                                <span style="color:#999;font-weight:400;font-size:0.85rem;">(optional)</span>
                            </label>
                            <textarea name="coverLetter"
                                      class="form-control"
                                      rows="6"
                                      maxlength="3000"
                                      placeholder="Tell the employer why you are the best fit for this role..."></textarea>
                            <div style="font-size:0.75rem;color:#999;text-align:right;margin-top:4px;">
                                Max 3000 characters
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Upload Resume
                                <span style="color:#999;font-weight:400;font-size:0.85rem;">(PDF, DOC, DOCX)</span>
                            </label>
                            <input type="file"
                                   name="resumeFile"
                                   class="form-control"
                                   accept=".pdf,.doc,.docx" />
                            <div style="font-size:0.75rem;color:#999;margin-top:4px;">
                                Max file size: 5MB
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn-apply-now">
                                Submit Application <i class="fas fa-paper-plane ms-2"></i>
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-back-jobs">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}