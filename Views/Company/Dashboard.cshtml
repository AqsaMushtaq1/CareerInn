@model CareerInn.Models.Company

@{
    ViewData["Title"] = "Company Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-root">

    <div class="dash-ambient" aria-hidden="true">
        <span class="ambient-blob blob-1"></span>
        <span class="ambient-blob blob-2"></span>
        <span class="ambient-blob blob-3"></span>
    </div>

    <!-- HERO -->
    <header class="dash-hero reveal-item">
        <div class="hero-left">
            <div class="hero-avatar">
                <span class="avatar-ring"></span>
                <div class="avatar-fallback" style="display:flex">
                    <span>@Model.Name.Substring(0, 1).ToUpper()</span>
                </div>
                <span class="avatar-status-dot" title="Active"></span>
            </div>
            <div class="hero-text">
                <p class="hero-greeting">Company Dashboard ✦</p>
                <h1 class="hero-name">Welcome, <em>@Model.Name</em></h1>
                <p class="hero-sub">@(Model.Location ?? "Location not set") &mdash; @(Model.Website ?? "")</p>
            </div>
        </div>
        <div class="hero-right">
            <div class="hero-quick-stats">
                <div class="qs-item">
                    <span class="qs-num">@ViewBag.TotalJobs</span>
                    <span class="qs-lbl">Total Jobs</span>
                </div>
                <div class="qs-divider"></div>
                <div class="qs-item">
                    <span class="qs-num">@ViewBag.ActiveJobs</span>
                    <span class="qs-lbl">Active</span>
                </div>
                <div class="qs-divider"></div>
                <div class="qs-item">
                    <span class="qs-num">@ViewBag.TotalApplications</span>
                    <span class="qs-lbl">Applications</span>
                </div>
            </div>
        </div>
    </header>

    <!-- KPI CARDS -->
    <section class="kpi-grid">
        <div class="kpi-card reveal-item">
            <div class="kpi-icon kpi-teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M3 9h18M9 21V9" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Total Jobs Posted</span>
                <span class="kpi-value">@ViewBag.TotalJobs</span>
                <span class="kpi-trend trend-up">All time</span>
            </div>
        </div>

        <div class="kpi-card reveal-item">
            <div class="kpi-icon kpi-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Total Applications</span>
                <span class="kpi-value">@ViewBag.TotalApplications</span>
                <span class="kpi-trend trend-up">Received</span>
            </div>
        </div>

        <div class="kpi-card reveal-item">
            <div class="kpi-icon kpi-teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Active Jobs</span>
                <span class="kpi-value">@ViewBag.ActiveJobs</span>
                <span class="kpi-trend trend-up">Currently live</span>
            </div>
        </div>

        <div class="kpi-card reveal-item">
            <div class="kpi-icon kpi-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-label">Company Since</span>
                <span class="kpi-value" style="font-size:1.2rem">@Model.CreatedAt.ToString("MMM yyyy")</span>
                <span class="kpi-trend trend-neutral">Member</span>
            </div>
        </div>
    </section>

    <!-- JOBS LIST -->
    <div class="dash-section reveal-item">
        <div class="section-header">
            <h2 class="section-title">
                <span class="title-dot teal-dot"></span>
                Your Job Listings
            </h2>
            <div style="display:flex;gap:0.75rem;">
                <a asp-controller="Company" asp-action="Applications" class="btn-view">
                    View Applications
                </a>
                <a asp-controller="Company" asp-action="PostJob" class="btn-view">
                    + Post New Job
                </a>
            </div>
        </div>

        @if (Model.Jobs.Any())
        {
            <div class="applications-list">
                @foreach (var job in Model.Jobs.OrderByDescending(j => j.PostedAt))
                {
                    <div class="app-row">
                        <div class="app-logo-wrap">
                            <div class="app-logo" style="background:#0d948820">
                                <span>@job.Title.Substring(0, 2).ToUpper()</span>
                            </div>
                        </div>
                        <div class="app-info">
                            <p class="app-title">@job.Title</p>
                            <p class="app-company">@job.Location &middot; @job.JobType</p>
                            <p class="app-date">Posted @job.PostedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                        <div class="app-right">
                            <span class="status-badge @(job.IsActive ? "badge-applied" : "badge-rejected")">
                                @(job.IsActive ? "Active" : "Inactive")
                            </span>
                            <a asp-controller="Jobs" asp-action="Details"
                                   asp-route-id="@job.Id" class="btn-view">
                                View
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p style="color:#888">No jobs posted yet.</p>
                <a asp-controller="Company" asp-action="PostJob" class="btn-view mt-3">
                    Post Your First Job
                </a>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}