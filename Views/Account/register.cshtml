@model CareerInn.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" />
}

<section class="register-page">

    <div class="register-mesh"></div>

    <div class="register-container">

        <!-- LEFT -->
        <div class="register-left" data-aos="fade-right">

            <div class="brand">
                <i class="fa-solid fa-briefcase"></i>
                <span>CareerInn</span>
            </div>

            <span class="section-tag">Future Starts Here</span>

            <h1>Find Opportunities That Shape Your Future</h1>

            <p>
                Build your professional journey with internships,
                jobs, networking and opportunities designed for
                ambitious students and graduates.
            </p>

            <div class="features">
                <div class="feature-box">
                    <i class="fa-solid fa-user-graduate"></i>
                    <div>
                        <h5>Student Focused</h5>
                        <span>Built for students & fresh graduates</span>
                    </div>
                </div>
                <div class="feature-box">
                    <i class="fa-solid fa-briefcase"></i>
                    <div>
                        <h5>Premium Opportunities</h5>
                        <span>Jobs, internships & career growth</span>
                    </div>
                </div>
                <div class="feature-box">
                    <i class="fa-solid fa-chart-line"></i>
                    <div>
                        <h5>Career Growth</h5>
                        <span>Track and improve your journey</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT -->
        <div class="register-right" data-aos="fade-left">

            <div class="form-card glass-card">

                <span class="section-tag">Join CareerInn</span>
                <h2>Create Account</h2>

                @if (ViewData.ModelState.ContainsKey("Email") && ViewData.ModelState["Email"].Errors.Count > 0 && ViewData.ModelState["Email"].Errors[0].ErrorMessage.Contains("registered"))
                {
                    <div class="alert alert-danger">Email is already registered. Please login.</div>
                }

                <form asp-action="Register" asp-controller="Account" method="post">

                    <div class="input-group">
                        <label>Full Name</label>
                        <input asp-for="FullName"
                               type="text"
                               placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="input-group">
                        <label>Email Address</label>
                        <input asp-for="Email"
                               type="email"
                               placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="input-group">
                        <label>I am a</label>
                        <select asp-for="Role" class="form-select">
                            <option value="">Select role</option>
                            <option value="JobSeeker">Job Seeker</option>
                            <option value="Employer">Employer</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="input-group">
                        <label>Password</label>
                        <div class="password-box">
                            <input asp-for="Password"
                                   type="password"
                                   id="password"
                                   placeholder="Create password (min 6 characters)" />
                            <i class="fa-solid fa-eye" id="togglePassword"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="input-group">
                        <label>Confirm Password</label>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <button class="register-btn" type="submit">
                        Create Account
                    </button>

                </form>

                <div class="bottom-text">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login">Login</a>
                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <script src="~/js/register.js"></script>
    <partial name="_ValidationScriptsPartial" />
}